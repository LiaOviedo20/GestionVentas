<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventos</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body style="background:#f4f6f9;">

<div class="container mt-5">

    <h1 class="mb-4">
        Sistema de Eventos
    </h1>


    <div class="card mb-5 shadow">

        <div class="card-body">

            <form action="/crear-evento" method="POST">

                <input
                    type="text"
                    name="nombre"
                    class="form-control mb-3"
                    placeholder="Nombre del evento"
                    required
                >

                <input
                    type="text"
                    name="descripcion"
                    class="form-control mb-3"
                    placeholder="Descripción"
                    required
                >

                <input
                    type="date"
                    name="fecha"
                    class="form-control mb-3"
                    required
                >

                <input
                    type="text"
                    name="lugar"
                    class="form-control mb-3"
                    placeholder="Lugar"
                    required
                >

                <input
                    type="number"
                    name="capacidad"
                    class="form-control mb-3"
                    placeholder="Capacidad"
                    required
                >

                <button class="btn btn-primary">
                    Crear Evento
                </button>

            </form>

        </div>

    </div>


    <div class="row">

        <% eventos.forEach(evento => { %>

            <div class="col-md-4 mb-4">

                <div class="card shadow">

                    <div class="card-body">

                        <h3>
                            <%= evento.nombre %>
                        </h3>

                        <p>
                            <%= evento.descripcion %>
                        </p>

                        <p>
                            📍 <%= evento.lugar %>
                        </p>

                        <p>
                            🎟️ Capacidad:
                            <%= evento.capacidad %>
                        </p>

                    

                        <form
                            action="/eliminar-evento/<%= evento.id %>"
                            method="POST"
                        >

                            <button class="btn btn-danger">
                                Eliminar
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>